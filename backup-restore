#!/bin/bash

LOG_FILE="/var/log/backup_remote.log"

# Función para manejar errores
handle_error() {
    log_message "[$(date +%Y-%m-%d\ %H:%M:%S)] Error en el proceso de restauración. Abortando."
    exit 1
}

# Función para loguear mensajes
log_message() {
    echo "[$(date +%Y-%m-%d\ %H:%M:%S)] $1" | tee -a "$LOG_FILE"
}

# Leer configuración
CONFIG_FILE="$HOME/.backup_remote.conf"
if [ ! -f "$CONFIG_FILE" ]; then
    CONFIG_FILE="/etc/backup_remote.conf"
fi

if [ -f "$CONFIG_FILE" ]; then
    log_message "Cargando configuración desde $CONFIG_FILE"
    source "$CONFIG_FILE"
else
    log_message "No se encontró ningún archivo de configuración."
    handle_error
fi

# Función para listar fechas disponibles
list_dates() {
    source_dir="$1"
    source "$CONFIG_FILE"

    for path in "${backup_paths[@]}"; do
        IFS=":" read -r config_source_dir remote_backup_subdir <<< "$path"
        remote_backup_subdir="${remote_backup_subdir%/}"
        if [ "$config_source_dir" == "$source_dir" ]; then
            break
        fi
    done

    if [ -z "$remote_backup_subdir" ]; then
        echo "No se encontró configuración para $source_dir"
        exit 1
    fi

    backup_files=$(ssh -i "$ssh_key" "$ssh_user@$ssh_server" \
        "ls -1 $remote_backup_dir/$remote_backup_subdir/*.tar.gz" | sort)

    echo "Fechas disponibles para restaurar en $source_dir:"
    for file in $backup_files; do
        backup_filename=$(basename "$file" .tar.gz)
        backup_date=$(echo "$backup_filename" | grep -oP '(\d{4}-\d{2}-\d{2}_\d{6})')
        echo "$backup_date"
    done
}

# Comprobar argumentos
if [ -z "$1" ]; then
    echo "Uso:"
    echo "  $0 <fecha-a-restaurar> <directorio-origen> <directorio-destino>"
    echo "  $0 --resume <fecha-a-restaurar> <directorio-origen> <directorio-destino>"
    echo "  $0 --list-dates <directorio-origen>"
    exit 1
fi

# Modo listar fechas
if [ "$1" == "--list-dates" ]; then
    if [ -z "$2" ]; then
        echo "Debe especificar el directorio de origen."
        exit 1
    fi
    list_dates "$2"
    exit 0
fi

# Detectar si es modo reanudar
resume_mode=false
if [ "$1" == "--resume" ]; then
    resume_mode=true
    shift
fi

restore_date="$1"
source_dir="$2"
target_dir="$3"

source "$CONFIG_FILE"

# Buscar subcarpeta remota
for path in "${backup_paths[@]}"; do
    IFS=":" read -r config_source_dir remote_backup_subdir <<< "$path"
    remote_backup_subdir="${remote_backup_subdir%/}"
    if [ "$config_source_dir" == "$source_dir" ]; then
        break
    fi
done

if [ -z "$remote_backup_subdir" ]; then
    log_message "No se encontró configuración para $source_dir"
    exit 1
fi

# Directorio de restauración
if [ -z "$target_dir" ]; then
    restore_base="/tmp/restore_${remote_backup_subdir}_$RANDOM"
else
    restore_base="$target_dir"
fi
mkdir -p "$restore_base"

# Archivo de checkpoint para reanudación
checkpoint_file="/tmp/restore_checkpoint_${remote_backup_subdir}.txt"
last_restored=""
if $resume_mode && [ -f "$checkpoint_file" ]; then
    last_restored=$(cat "$checkpoint_file")
    log_message "Modo reanudar activado: continuando después de $last_restored"
elif $resume_mode && [ ! -f "$checkpoint_file" ]; then
    log_message "No existe checkpoint previo, se restaurará desde el inicio."
fi

# Obtener lista de backups
backup_files=$(ssh -i "$ssh_key" "$ssh_user@$ssh_server" \
    "ls -1 $remote_backup_dir/$remote_backup_subdir/*.tar.gz" | sort)

# Filtrar hasta la fecha solicitada
files_to_restore=()
for file in $backup_files; do
    backup_filename=$(basename "$file" .tar.gz)
    backup_date=$(echo "$backup_filename" | grep -oP '(\d{4}-\d{2}-\d{2}_\d{6})')
    if [ "$backup_date" \< "$restore_date" ] || [ "$backup_date" == "$restore_date" ]; then
        files_to_restore+=("$file")
    fi
done

if [ ${#files_to_restore[@]} -eq 0 ]; then
    log_message "No se encontraron backups para restaurar hasta $restore_date"
    exit 1
fi

# Restaurar incrementales con barra de progreso
for file in "${files_to_restore[@]}"; do
    backup_filename=$(basename "$file" .tar.gz)

    # Si estamos en modo resume y ya se aplicó este backup, lo saltamos
if [[ "$resume_mode" == true && -n "$last_restored" && ( "$backup_filename" < "$last_restored" || "$backup_filename" == "$last_restored" ) ]]; then
        log_message "Saltando $backup_filename (ya restaurado)"
        continue
    fi

    # Obtener tamaño remoto para mostrar barra de progreso
    file_size=$(ssh -i "$ssh_key" "$ssh_user@$ssh_server" "stat -c %s $file" 2>/dev/null)
    log_message "Restaurando desde $file (tamaño: $((file_size/1024/1024)) MB)"

    # Restaurar con barra de progreso y opciones para sobrescribir directorios
    ssh -i "$ssh_key" "$ssh_user@$ssh_server" "cat $file" \
        | pv -s "$file_size" \
        | tar --extract --gzip --overwrite --directory="$restore_base"

    if [ $? -ne 0 ]; then
        log_message "Error al restaurar desde $file"
        handle_error
    fi

    # Guardar checkpoint (solo si no es la última ejecución sin resume)
    echo "$backup_filename" > "$checkpoint_file"
done

log_message "Restauración completada en $restore_base"
