#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=backup-lib.sh
source "${SCRIPT_DIR}/backup-lib.sh"

usage() {
    cat <<EOF
Uso:
  $0 --list|--list-dates <directorio-origen>
  $0 --restore <directorio-origen> <fecha> [directorio-destino]
  $0 --restore-latest <directorio-origen> [directorio-destino]
  $0 <fecha> <directorio-origen> [directorio-destino]

Fecha: YYYY-MM-DD_HHMMSS
Si no se indica destino, se restaura en /tmp/restore_<subdir>_<pid>
EOF
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
    usage
    exit 0
fi
if [[ ${1:-} == "" ]]; then
    usage
    exit 1
fi

init_log
load_backup_config

list_remote_basenames() {
    local dest_dir=$1
    list_remote_archives "$dest_dir"
}

# Rellena files_to_restore con rutas remotas completas, en orden de aplicación.
select_restore_chain() {
    local dest_dir=$1
    local restore_date=$2
    local -a candidates=()
    local -a dated=()
    local f start_full="" start_date=""

    files_to_restore=()
    mapfile -t candidates < <(list_remote_basenames "$dest_dir")

    for f in "${candidates[@]}"; do
        [[ -z "$f" ]] && continue
        parse_backup_name "$f"
        if [[ -z "$parsed_date" ]]; then
            continue
        fi
        if [[ "$parsed_date" < "$restore_date" || "$parsed_date" == "$restore_date" ]]; then
            dated+=("$f")
            if [[ "$parsed_kind" == "full" ]]; then
                start_full="$f"
                start_date="$parsed_date"
            fi
        fi
    done

    if [[ ${#dated[@]} -eq 0 ]]; then
        return 1
    fi

    if [[ -n "$start_date" ]]; then
        log_message "Cadena GNU tar desde el full $start_full"
        for f in "${dated[@]}"; do
            parse_backup_name "$f"
            if [[ "$parsed_date" > "$start_date" || "$parsed_date" == "$start_date" ]]; then
                files_to_restore+=("${dest_dir}/${f}")
            fi
        done
    else
        log_message "Aviso: no hay archivo -full.tar.gz anterior a $restore_date; se aplican todos los tars hasta esa fecha (archivos antiguos)"
        for f in "${dated[@]}"; do
            files_to_restore+=("${dest_dir}/${f}")
        done
    fi
}

list_dates() {
    local source_dir=$1
    local dest_dir f
    if ! resolve_remote_subdir "$source_dir"; then
        handle_error "no hay backup configurado para $source_dir"
    fi
    dest_dir="${remote_backup_dir}/${remote_backup_subdir}"
    echo "Fechas disponibles para restaurar ${source_dir}:"
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        parse_backup_name "$f"
        if [[ -n "$parsed_date" ]]; then
            printf '%s  %s\n' "$parsed_date" "$parsed_kind"
        fi
    done < <(list_remote_basenames "$dest_dir")
}

latest_backup_date() {
    local dest_dir=$1
    local f latest=""
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        parse_backup_name "$f"
        if [[ -n "$parsed_date" ]]; then
            latest="$parsed_date"
        fi
    done < <(list_remote_basenames "$dest_dir")
    printf '%s' "$latest"
}

run_restore() {
    local source_dir=$1
    local restore_date=$2
    local dest=${3:-}
    local dest_dir tar_rc ssh_rc
    local -a pipe_status

    if ! resolve_remote_subdir "$source_dir"; then
        handle_error "no hay backup configurado para $source_dir"
    fi
    dest_dir="${remote_backup_dir}/${remote_backup_subdir}"

    if [[ -z "$dest" ]]; then
        dest="/tmp/restore_${remote_backup_subdir}_$$"
    fi
    mkdir -p "$dest"
    log_message "Restaurando $source_dir @ $restore_date → $dest"

    if ! select_restore_chain "$dest_dir" "$restore_date"; then
        handle_error "no hay backups hasta la fecha $restore_date"
    fi

    for f in "${files_to_restore[@]}"; do
        log_message "Aplicando $(basename -- "$f")"
        set +e
        ssh_cmd "cat $(printf '%q' "$f")" | tar --extract --gzip --listed-incremental=/dev/null --directory="$dest"
        pipe_status=("${PIPESTATUS[@]}")
        ssh_rc=${pipe_status[0]}
        tar_rc=${pipe_status[1]}
        set -e
        if (( tar_rc > 1 || ssh_rc != 0 )); then
            handle_error "al extraer $f (tar=${tar_rc} ssh=${ssh_rc})"
        fi
        if (( tar_rc == 1 )); then
            log_message "Aviso: tar extract código 1 al aplicar $(basename -- "$f")"
        fi
    done

    log_message "Restauración completada en $dest"
}

case "$1" in
    --list|--list-dates)
        [[ -n "${2:-}" ]] || { usage; exit 1; }
        list_dates "$2"
        ;;
    --restore)
        [[ -n "${2:-}" && -n "${3:-}" ]] || { usage; exit 1; }
        run_restore "$2" "$3" "${4:-}"
        ;;
    --restore-latest)
        [[ -n "${2:-}" ]] || { usage; exit 1; }
        if ! resolve_remote_subdir "$2"; then
            handle_error "no hay backup configurado para $2"
        fi
        latest=$(latest_backup_date "${remote_backup_dir}/${remote_backup_subdir}")
        [[ -n "$latest" ]] || handle_error "no hay archivos de backup remotos"
        run_restore "$2" "$latest" "${3:-}"
        ;;
    *)
        [[ -n "${2:-}" ]] || { usage; exit 1; }
        run_restore "$2" "$1" "${3:-}"
        ;;
esac
